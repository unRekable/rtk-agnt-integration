{
  "name": "rtk-agnt-integration",
  "version": "1.0.0",
  "description": "AGNT plugin and Node.js wrapper for RTK (Rust Token Killer). Compress shell output by 60-90% before LLM ingestion.",
  "type": "module",
  "main": "src/rtk-runner.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ __tests__/",
    "build:plugin": "node bin/build-plugin.js",
    "install:agnt": "node bin/install-to-agnt.js"
  },
  "keywords": [
    "agnt",
    "rtk",
    "rust-token-killer",
    "llm",
    "token-optimization",
    "cli-proxy",
    "plugin"
