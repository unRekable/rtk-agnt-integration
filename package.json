  "repository": {
    "type": "git",
    "url": "https://github.com/unRekable/rtk-agnt-integration.git"
  },
  "bugs": {
    "url": "https://github.com/unRekable/rtk-agnt-integration/issues"
  },
  "homepage": "https://github.com/unRekable/rtk-agnt-integration#readme",
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
